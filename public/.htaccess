<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# 0) Remover barra final (mantém URLs canônicas sem "/")
# Ex.: /sobre-nos/ -> /sobre-nos
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{THE_REQUEST} \s/+(.+?)/+\s [NC]
RewriteRule ^ %1 [R=301,L]

# 1) Priorizar HTML estático para rotas "limpas" (sem extensão)
# Ex.: /sobre-nos -> /sobre-nos.html (se existir)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{1,6}$
RewriteCond %{DOCUMENT_ROOT}/%{REQUEST_URI}.html -f
RewriteRule ^(.+)$ $1.html [L]

# 2) Fallback para SPA (somente quando não existir HTML estático)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]
</IfModule>
